# =====================================================================
# AlertX Backend Environment Configuration Template
# Copy this file to .env in backend/ and fill in the values.
# =====================================================================

# --- Core Security ---
# REQUIRED: 64-character random hex string. If missing, a random key is generated on startup (invalidates tokens on restart).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret_key_64_hex_chars

# --- Network & URLs ---
# Public URL of the backend (e.g. https://your-space.hf.space). Used for email links and webhook callbacks.
# On Hugging Face Spaces, if left blank, SPACE_HOST will be used automatically.
PUBLIC_URL=http://localhost:8000

# URL of the deployed frontend dashboard (e.g. https://your-app.vercel.app or http://localhost:5500)
FRONTEND_URL=http://localhost:5500

# Optional CORS allowed origins: comma-separated list of origins. If empty/unset, defaults to ["*"] allowing all.
# Example: https://alertx-dashboard.vercel.app,http://localhost:5500
FRONTEND_ORIGIN=

# --- Voice AI Dispatch (Vapi.ai) ---
VAPI_API_KEY=your_vapi_api_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
# Destination phone number to receive emergency call dispatch
DISPATCH_PHONE_NUMBER=+1234567890

# --- Email Alerts (SMTP) ---
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_RECIPIENT=alerts-receiver@example.com

# --- Cloud Database (Firebase Firestore) ---
# Optional: One-line JSON string of your Firebase Service Account credentials.
# If unset, AlertX automatically falls back to local SQLite (local_users.db).
FIREBASE_SERVICE_ACCOUNT=

# --- Camera / Video Stream ---
# Leave unset on cloud servers (a cloud container has no physical webcam).
# The frontend dashboard uses the client's browser camera.
# For local RTSP/IP camera testing, set to RTSP stream URL or 0 for local webcam:
# ALERTX_CAMERA=0

# --- Image Hosting ---
# Leave unset or false for privacy. When false/unset, frames are NOT uploaded to public image hosts.
ALLOW_PUBLIC_IMAGE_HOST=false

